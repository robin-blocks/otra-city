    "api:check": "node scripts/api-check.mjs",
    "telemetry": "node scripts/telemetry.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "map": "node scripts/build-map.mjs",
    "map:check": "node scripts/map-check.mjs",
    "posters": "node scripts/render-posters.mjs",
