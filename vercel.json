{
  "functions": {
    "api/submit.mjs": {
      "includeFiles": "node_modules/draco3dgltf/**"
    }
  },
  "rewrites": [
    { "source": "/s/:slug", "destination": "/index.html" },
    { "source": "/embed", "destination": "/index.html" },
    { "source": "/claim", "destination": "/claim.html" },
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/api/plots", "destination": "/plots/index.json" },
    { "source": "/api/plots/submit", "destination": "/api/submit" },
    { "source": "/api/plots/:slug", "destination": "/api/plot-status?slug=:slug" },

    { "source": "/api/passport", "destination": "/api/sunset" },
    { "source": "/api/map", "destination": "/api/sunset" },
    { "source": "/api/status", "destination": "/api/sunset" },
    { "source": "/api/buildings", "destination": "/api/sunset" },
    { "source": "/api/leaderboard", "destination": "/api/sunset" },
    { "source": "/ws", "destination": "/api/sunset" }
  ],
  "redirects": [
    { "source": "/quick-start", "destination": "/docs/agent-context.md", "permanent": false }
  ],
  "headers": [
    {
      "source": "/plots/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/docs/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
